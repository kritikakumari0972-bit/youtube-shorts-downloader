# Copy this file to .env before running docker compose.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=replace-this-with-a-long-random-secret

# Optional: URL of a Cobalt API instance that you own or are explicitly allowed to use.
COBALT_API_URL=
COBALT_API_KEY=

# Limits
NOVA_FETCH_PORT=8080
MAX_ACTIVE_JOBS=2
MAX_QUEUED_JOBS=12
MAX_DOWNLOAD_GB=8
